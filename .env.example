# Postgres connection string. Required.
DATABASE_URL=postgresql://user:password@localhost:5432/ralphscore

# Server listening port (Railway sets this automatically in production).
PORT=3001

# Set to "production" on Railway. Currently only affects SSL handshaking
# in db.js (rejectUnauthorized: false in prod for Railway's internal CA).
NODE_ENV=development

# Admin token. Required for the campaign admin endpoints (PUT /:id/image,
# PUT /:id/media, POST /campaigns) AND the /api/admin/verify endpoint
# the frontend uses to validate the "Unlock admin" entry. Generate with
# `openssl rand -base64 32`. Empty/unset = admin operations are disabled
# entirely (the frontend will surface "Admin operations are disabled on
# this deployment"), which is the safe default.
ADMIN_TOKEN=
